<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_blog_highlight_view_blog_post_form" model="ir.ui.view">
      <field name="name">website_blog_highlight.view.blog_post.form</field>
      <field name="model">blog.post</field>
      <field name="inherit_id" ref="website_blog.view_blog_post_form" />
      <field name="arch" type="xml">
        <xpath expr="//field[@name='author_id']" position="after">
            <field name="is_highlighted" widget="boolean_toggle"/>
        </xpath>
      </field>
    </record>
</odoo>
