<odoo>
    <data>
        <!-- Filters for Dynamic Filter -->
        <record id="dynamic_snippet_official_employee_filter" model="ir.filters">
            <field name="name">Official Employees</field>
            <field name="model_id">hr.employee</field>
            <field name="domain">[('web_category', '=', 'official')]</field>
            <field name="sort">["name"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>
        <record id="dynamic_snippet_colleague_employee_filter" model="ir.filters">
            <field name="name">Colleague Employees</field>
            <field name="model_id">hr.employee</field>
            <field name="domain">[('web_category', '=', 'colleague')]</field>
            <field name="sort">["name"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>
        <record id="dynamic_snippet_former_colleague_employee_filter" model="ir.filters">
            <field name="name">Former Colleague Employees</field>
            <field name="model_id">hr.employee</field>
            <field name="domain">[('web_category', '=', 'former_colleague')]</field>
            <field name="sort">["name"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>

        <!-- Dynamic Filter -->
        <record id="dynamic_filter_official_employees" model="website.snippet.filter">
            <field name="name">Official Employees</field>
            <field name="filter_id" ref="hr_profile_page.dynamic_snippet_official_employee_filter"/>
            <field name="field_names">name</field>
            <field name="limit">16</field>
        </record>
        <record id="dynamic_filter_colleague_employees" model="website.snippet.filter">
            <field name="name">Colleague Employees</field>
            <field name="filter_id" ref="hr_profile_page.dynamic_snippet_colleague_employee_filter"/>
            <field name="field_names">name</field>
            <field name="limit">16</field>
        </record>
        <record id="dynamic_filter_former_colleague_employees" model="website.snippet.filter">
            <field name="name">Colleague Employees</field>
            <field name="filter_id" ref="hr_profile_page.dynamic_snippet_former_colleague_employee_filter"/>
            <field name="field_names">name</field>
            <field name="limit">16</field>
        </record>
    </data>
</odoo>
