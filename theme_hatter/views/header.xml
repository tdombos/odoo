<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" name="Custom Header">
        <xpath expr="//header" position="replace">
            <header >
                <t t-call="website.navbar">
                    <t t-set="_navbar_classes"
                       t-valuef="o_header_force_no_radius d-none d-lg-block p-0 rounded-0"/>

                    <div id="o_main_nav" class="o_main_nav">
                        <div aria-label="Top"
                             t-if="is_view_active('website.header_text_element') or is_view_active('website.header_social_links') or is_view_active('website.header_search_box') or is_view_active('website.header_call_to_action')"
                             class="o_header_sales_three_top o_header-top_line o_header_hide_on_scroll position-relative border-bottom z-index-1 o_border_contrast">
                            <div class="container d-flex justify-content-between gap-3 h-100">
                                <ul class="navbar-nav align-items-center gap-3 py-1">
                                    <!-- Text element -->
                                    <t t-call="website.placeholder_header_text_element">
                                        <t t-set="_txt_elt_content" t-valuef="list"/>
                                        <t t-set="_div_class" t-valuef="mx-auto"/>
                                        <t t-set="_item_class" t-valuef="flex-basis-0 flex-grow-1 flex-shrink-0"/>
                                    </t>
                                </ul>
                                <ul class="navbar-nav">
                                    <!-- Sign In -->
                                    <t t-call="portal.placeholder_user_sign_in">
                                        <t t-set="_item_class" t-valuef="position-relative"/>
                                        <t t-set="_link_class"
                                           t-valuef="nav-link btn-sm fw-bold text-uppercase o_nav-link_secondary"/>
                                    </t>
                                    <!-- User Dropdown -->
                                    <t t-call="portal.user_dropdown">
                                        <t t-set="_user_name" t-value="true"/>
                                        <t t-set="_item_class" t-valuef="dropdown"/>
                                        <t t-set="_link_class"
                                           t-valuef="nav-link btn-sm d-flex align-items-center fw-bold text-uppercase o_nav-link_secondary"/>
                                        <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end"/>
                                    </t>
                                    <!-- Social -->
                                    <t t-call="website.placeholder_header_social_links"/>
                                    <!-- Call To Action -->
                                    <t t-call="website.header_call_to_action_stretched">
                                        <t t-set="_div_class" t-valuef="d-flex h-100 ps-2"/>
                                    </t>

                                </ul>
                            </div>
                        </div>
                        <div aria-label="Bottom" class="container d-flex align-items-center py-2 flex-1 o_header-menu">
                            <!-- Brand -->
                            <t t-call="website.placeholder_header_brand">
                                <t t-set="_link_class" t-valuef="me-4"/>
                            </t>
                            <div class="d-flex align-items-center menu-container">
                                <!-- Navbar -->
                                <t t-call="website.navbar_nav">
                                    <t t-set="_nav_class" t-valuef="justify-content-start"/>

                                    <!-- Menu -->
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-call="website.submenu">
                                            <t t-set="item_class" t-valuef="nav-item"/>
                                            <t t-set="link_class" t-valuef="nav-link"/>
                                        </t>
                                    </t>
                                </t>
                                <ul class="navbar-nav justify-content-end align-items-center gap-2 o_header_separator ms-auto">
                                    <!-- Search bar -->
                                    <t t-call="website.placeholder_header_search_box">
                                        <t t-set="_input_classes" t-valuef="border-0 border-start rounded-0"/>
                                        <t t-set="_submit_classes" t-valuef="rounded-0 bg-o-color-4"/>
                                        <t t-set="_form_classes" t-valuef="h-100 z-index-0"/>
                                        <t t-set="_classes" t-valuef="h-100"/>
                                    </t>
                                    <!-- Language Selector -->
                                    <t t-call="website.placeholder_header_language_selector">
                                        <t t-set="_btn_class"
                                           t-valuef="nav-link btn-sm d-flex align-items-center fw-bold text-uppercase o_nav-link_secondary"/>
                                        <t t-set="_txt_class" t-valuef="ms-1"/>
                                        <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end"/>
                                        <t t-set="_item_class" t-valuef="position-relative"/>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-call="website.template_header_mobile">
                    <t t-set="_txt_elt_content" t-valuef="list"/>
                    <t t-set="_extra_navbar_classes" t-valuef="o_header_force_no_radius"/>
                </t>
            </header>
        </xpath>
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="#{'o_no_autohide_menu'}" separator=" "/>
        </xpath>
    </template>
    <template id="no_autohide_menu" inherit_id="website.layout" active="False">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="#{'o_no_autohide_menu'}" separator=" "/>
        </xpath>
    </template>

</odoo>