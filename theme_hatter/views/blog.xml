<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Minimal card layout -->
    <template id="dynamic_filter_template_blog_post_minimal_card" name="Minimal card layout">
        <div t-foreach="records" t-as="data" class="s_blog_posts_post w-100" data-number-of-elements="3">
            <t t-set="record" t-value="data['_record']"/>
            <div class="card">
                <a class="s_blog_posts_post_cover" t-att-href="data['call_to_action_url']">
                    <t t-call="website.record_cover">
                        <t t-set="_record" t-value="record"/>
                        <t t-set="_resize_height" t-value="256"/>
                        <t t-set="_resize_width" t-value="256"/>
                        <t t-set="additionnal_classes" t-value="'thumb'"/>
                    </t>
                </a>
                <div class="card-body">
                    <span class="text-muted mb-0" t-field="record.post_date"
                          t-options='{"format": "yyyy MMMM d."}'/>
                    <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                    <a t-att-href="data['call_to_action_url']">
                        <h4 class="mb-0" t-field="record.name"/>
                    </a>
                </div>
            </div>
        </div>
    </template>
    <!-- Big card layout -->
    <template id="dynamic_filter_template_blog_post_big_card" name="Big card layout">
        <div t-foreach="records" t-as="data" class="s_blog_posts_post pb32 w-100" data-number-of-elements="1">
            <t t-set="record" t-value="data['_record']"/>
            <div class="card">
                <a class="s_blog_posts_post_cover" t-att-href="data['call_to_action_url']">
                    <t t-call="website.record_cover">
                        <t t-set="_record" t-value="record"/>
                        <t t-set="_resize_height" t-value="512"/>
                        <t t-set="_resize_width" t-value="512"/>
                        <t t-set="additionnal_classes" t-value="'thumb'"/>
                    </t>
                </a>
                <div class="card-body">
                    <span class="text-muted mb-0" t-field="record.post_date"
                          t-options='{"format": "yyyy MMMM d."}'/>
                    <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                    <a t-att-href="data['call_to_action_url']">
                        <h3 class="mb-0" t-field="record.name"/>
                    </a>
                </div>
            </div>
        </div>
    </template>
</odoo>